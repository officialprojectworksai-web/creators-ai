# ==============================================================================
# CreatorOS AI — Environment Configuration Template
# All secret values must be supplied via local .env.local or Vercel Project Settings.
# ==============================================================================

# Supabase Configuration (Client & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-operations

# Configurable Multimodal AI LLM Engine
# Optional: If omitted, CreatorOS uses its deterministic structured AI brief builder
AI_PROVIDER_API_KEY=your-gemini-or-openai-api-key
AI_MODEL=gemini-1.5-flash

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
